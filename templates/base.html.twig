<!DOCTYPE html>
<html lang="fr">
  <head>
    {# Clever Brand Kit — snippet <head> #}
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#13172e">
    <title>{% block title %}FrankenPHP + Symfony · Démo Clever Cloud{% endblock %}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300..800;1,300..800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('cc-brand.css') }}">
    <link rel="stylesheet" href="{{ asset('demo.css') }}">
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 101 116'%3E%3Cpolygon fill='%23AB2B4A' points='100.423 29.134 100.423 86.868 89.721 73.062 83.76 58.003 83.756 58.003 89.418 42.731'/%3E%3Cpolygon fill='%23E87A68' points='.429 29.134 .429 86.868 9.889 73.481 17.092 58.003 17.096 58.003 9.773 43.319'/%3E%3Cpolygon fill='%23D74D4E' points='83.756 58.003 52.241 60.003 17.092 58.003 31.76 29.134 50.426 .269 70.722 31.961'/%3E%3Cpolygon fill='%23BD3246' points='100.423 29.134 83.756 58.003 50.426 .269'/%3E%3Cpolygon fill='%23F19175' points='50.426 .269 17.092 58.003 .425 29.134'/%3E%3Cpolygon fill='%23CF3942' points='83.756 58.003 72.365 82.931 50.426 115.737 27.849 81.83 17.092 58.003'/%3E%3Cpolygon fill='%23E0625B' points='50.426 115.737 .425 86.868 17.092 58.003'/%3E%3Cpolygon fill='%239A244F' points='50.422 115.737 100.423 86.868 83.756 58.003'/%3E%3C/svg%3E">
    {% block stylesheets %}{% endblock %}
  </head>
  <body>

    <header class="cc-topbar">
      <div class="cc-container cc-topbar__inner">
        <a href="https://www.clever.cloud" target="_blank" rel="noopener" aria-label="Clever Cloud">
          {% include 'partials/cc-logo.svg.twig' %}
        </a>
        <span class="cc-topbar__sep"></span>
        <div class="cc-topbar__demo"><small>Démo</small>FrankenPHP + Symfony</div>
        <span class="cc-topbar__spacer"></span>
        <nav class="cc-topbar__nav" aria-label="Statut et liens">
          <span class="cc-pill cc-pill--mono cc-hide-sm">PHP {{ cc is defined ? cc.phpShort : '8.4' }} · Symfony 7 · FrankenPHP worker</span>
          {% if cc is defined and cc.live %}
            <span class="cc-pill cc-pill--live"><span class="cc-dot"></span>Live on Clever Cloud</span>
          {% else %}
            <span class="cc-pill cc-pill--muted"><span class="cc-dot cc-dot--muted"></span>Local · hors Clever Cloud</span>
          {% endif %}
          <a class="cc-topbar__link" href="/api">Swagger UI</a>
          <a class="cc-pill cc-pill--gradient" href="https://academy.clever.cloud/" target="_blank" rel="noopener">Se certifier ↗</a>
        </nav>
      </div>
    </header>

    <main>
      {% block body %}{% endblock %}
    </main>

    <footer class="cc-footer">
      <div class="cc-container">
        <div class="cc-footer__inner">
          <div class="cc-footer__brand">
            {% include 'partials/cc-logo.svg.twig' %}
            <p>PaaS européen entièrement managé. Un git push : la plateforme détecte le runtime, installe les dépendances et s'occupe du reste.</p>
            <div class="cc-trust"><span>ISO 27001</span><span>HDS</span><span>HÉBERGÉ EN FRANCE</span></div>
          </div>
          <div>
            <h4>Documentation</h4>
            <ul>
              <li><a href="https://www.clever.cloud/developers/doc/applications/frankenphp/" target="_blank" rel="noopener">Runtime FrankenPHP</a></li>
              <li><a href="https://www.clever.cloud/developers/doc/applications/php/" target="_blank" rel="noopener">Runtime PHP</a></li>
              <li><a href="https://console.clever-cloud.com" target="_blank" rel="noopener">Console Clever Cloud</a></li>
              <li><a href="https://frankenphp.dev/docs/" target="_blank" rel="noopener">FrankenPHP</a></li>
              <li><a href="https://api-platform.com/docs/" target="_blank" rel="noopener">API Platform</a></li>
            </ul>
          </div>
          <div>
            <h4>Aller plus loin</h4>
            <ul>
              <li><a class="is-cert" href="https://academy.clever.cloud/" target="_blank" rel="noopener">Certification Clever Cloud ↗</a></li>
              <li><a href="https://github.com/Vitiosum/demo-php-frankenphp" target="_blank" rel="noopener">Code source sur GitHub</a></li>
              <li><a href="https://www.clever.cloud" target="_blank" rel="noopener">clever.cloud</a></li>
            </ul>
          </div>
        </div>
        <div class="cc-footer__bottom"><span>Démo réalisée par l'équipe avant-vente Clever Cloud</span><span>© {{ 'now'|date('Y') }} Clever Cloud</span></div>
      </div>
    </footer>

    {% block javascripts %}{% endblock %}
  </body>
</html>
