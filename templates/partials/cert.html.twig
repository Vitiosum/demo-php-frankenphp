{# Bloc certification Clever Cloud Academy : le poinçon du maître. Le badge SVG porte des id : une seule inclusion par page. #}
<section class="fp-cert" id="certification" aria-labelledby="cert-title">
  <figure class="fp-cert__stamp">
    <a href="https://academy.clever.cloud/" target="_blank" rel="noopener" aria-label="Clever Cloud Academy">
      {% include 'partials/cc-badge.svg.twig' %}
