    <div class="fp-cert__tracks">
      <a href="https://academy.clever.cloud/course/view.php?id=2" target="_blank" rel="noopener"><b>Cloud Computing Fundamentals</b><span>Concepts, architectures, IaaS, PaaS et FaaS.</span></a>
      <a href="https://academy.clever.cloud/course/section.php?id=18" target="_blank" rel="noopener"><b>Advanced Deployment</b><span>Déployer, scaler et opérer une app comme celle-ci.</span></a>
    </div>
    <div class="fp-cert__cta">
      <a class="cc-btn cc-btn--gradient" href="https://academy.clever.cloud/" target="_blank" rel="noopener">Passer la certification</a>
      <small>academy.clever.cloud</small>
    </div>
  </div>
