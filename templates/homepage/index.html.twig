{% extends 'base.html.twig' %}

{% block title %}FrankenPHP + Symfony · Démo Clever Cloud{% endblock %}

{% block body %}

{# ── Héro ── #}
<section class="cc-hero">
  <div class="cc-container">
    <div class="cc-eyebrow cc-reveal" style="--i:0">Runtime FrankenPHP · Symfony 7 · API Platform</div>
    <h1 class="cc-hero__title hero-title cc-reveal" style="--i:1">PHP en mode worker,<br><span class="cc-grad-text">déployé sur Clever Cloud.</span></h1>
    <p class="cc-hero__lead cc-reveal" style="--i:2">Une application Symfony 7 servie par FrankenPHP en mode worker, avec API Platform et sa Swagger UI. <strong>Aucun Dockerfile à écrire</strong> : Clever Cloud fournit le binaire FrankenPHP, installe les dépendances Composer, démarre le worker et publie l'app en HTTPS sur son domaine.</p>
    <ul class="cc-facts cc-reveal" style="--i:3">
      <li>Runtime FrankenPHP managé</li>
      <li>Worker FrankenPHP persistant</li>
      <li>HTTPS et domaine inclus</li>
      <li>Health check sur /health</li>
    </ul>
    <div class="cc-hero__actions cc-reveal" style="--i:4">
      <a class="cc-btn cc-btn--gradient" href="/api">Ouvrir Swagger UI <span class="cc-btn__arrow">→</span></a>
      <a class="cc-btn" href="/api/monsters.jsonld">Monsters API · JSON-LD</a>
    </div>
  </div>
</section>

{# ── Certification Clever Cloud ── #}
<section class="cc-section" style="padding-top:0">
  <div class="cc-container">
    <div class="cc-cert cc-reveal" style="--i:5">
      {% include 'partials/cc-badge.svg.twig' %}
      <div>
        <div class="cc-cert__kicker">Clever Cloud Academy</div>
        <h2 class="cc-cert__title">Devenez <span class="cc-grad-text">certifié Clever Cloud</span></h2>
        <p class="cc-cert__text">Deux parcours officiels, de la théorie au déploiement avancé. Le badge numérique est délivré automatiquement dès la validation.</p>
        <div class="cc-tracks">
          <a class="cc-track" href="https://academy.clever.cloud/course/view.php?id=2" target="_blank" rel="noopener">
            <span class="cc-track__num">01</span>
            <span><span class="cc-track__name">Cloud Computing Fundamentals</span><br><span class="cc-track__desc">Concepts, architectures, modèles IaaS · PaaS · FaaS.</span></span>
          </a>
          <a class="cc-track" href="https://academy.clever.cloud/course/section.php?id=18" target="_blank" rel="noopener">
            <span class="cc-track__num">02</span>
            <span><span class="cc-track__name">Advanced Deployment</span><br><span class="cc-track__desc">Maîtriser le déploiement d'applications sur Clever Cloud.</span></span>
          </a>
        </div>
        <div class="cc-cert__actions">
          <a class="cc-btn cc-btn--gradient" href="https://academy.clever.cloud/" target="_blank" rel="noopener">Obtenir ma certification <span class="cc-btn__arrow">→</span></a>
          <span class="cc-cert__note">academy.clever.cloud · développeurs, partenaires, équipes</span>
        </div>
      </div>
    </div>
  </div>
</section>

{# ── Contenu démo : onglets + panneau plateforme ── #}
<section class="cc-section">
  <div class="cc-container">
    <div class="cc-section__head cc-reveal" style="--i:6">
      <h2 class="cc-section__title">Sous le capot</h2>
      <span class="cc-section__sub">Worker mode · API Platform · Performance · Deploy</span>
    </div>
    <div class="cc-tabs cc-reveal" style="--i:6" role="tablist" aria-label="Facettes de la démo">
      <button class="cc-tab is-active" type="button" role="tab" aria-selected="true" aria-controls="panel-worker" data-tab="worker">Worker Mode</button>
      <button class="cc-tab" type="button" role="tab" aria-selected="false" aria-controls="panel-api" data-tab="api">API Platform</button>
      <button class="cc-tab" type="button" role="tab" aria-selected="false" aria-controls="panel-perf" data-tab="perf">Performance</button>
      <button class="cc-tab" type="button" role="tab" aria-selected="false" aria-controls="panel-deploy" data-tab="deploy">Deploy</button>
    </div>

    <div class="cc-grid cc-grid--2 cc-mt-2">
      <div class="cc-reveal" style="--i:7">

        <div class="cc-card cc-card--pad panel" id="panel-worker" role="tabpanel" data-panel="worker">
          <div class="panel__head">
            <div class="cc-card__label">FrankenPHP Worker</div>
            <span class="cc-badge cc-badge--ok">persistant</span>
          </div>
          <div class="cc-card__title">Symfony est booté une fois, puis reste en mémoire</div>
          <p class="cc-card__hint">Le kernel n'est plus reconstruit à chaque requête : le worker boucle sur <span class="cc-kbd">frankenphp_handle_request()</span> et sert les requêtes suivantes à chaud.</p>
          <ul class="cc-list">
            <li class="cc-row"><span class="cc-row__id">01</span><div class="cc-row__main"><div class="cc-row__title">Boot</div><div class="cc-row__meta">Chargement du kernel Symfony et du conteneur de services</div></div><span class="cc-badge cc-badge--ok">ok</span></li>
            <li class="cc-row"><span class="cc-row__id">02</span><div class="cc-row__main"><div class="cc-row__title">Warm</div><div class="cc-row__meta">Cache, autoload et services préchauffés</div></div><span class="cc-badge cc-badge--ok">ok</span></li>
            <li class="cc-row"><span class="cc-row__id">03</span><div class="cc-row__main"><div class="cc-row__title">Ready</div><div class="cc-row__meta">Le worker attend les requêtes transmises par Caddy</div></div><span class="cc-badge cc-badge--ok">ok</span></li>
            <li class="cc-row"><span class="cc-row__id">04</span><div class="cc-row__main"><div class="cc-row__title">Serving</div><div class="cc-row__meta">Chaque requête réutilise le même processus PHP</div></div><span class="cc-badge cc-badge--critical">live</span></li>
          </ul>
          <pre class="cc-code"><span class="c"># Caddyfile</span>
frankenphp {
    <span class="k">worker</span> ./public/index.php
}</pre>
        </div>

        <div class="cc-card cc-card--pad panel" id="panel-api" role="tabpanel" data-panel="api" hidden>
          <div class="panel__head">
            <div class="cc-card__label">API Platform 3</div>
            <span class="cc-badge cc-badge--info">JSON-LD · Hydra</span>
          </div>
          <div class="cc-card__title">Une entité, une annotation, une API complète</div>
          <p class="cc-card__hint">L'entité <span class="cc-kbd">Monster</span> porte <span class="cc-kbd">#[ApiResource]</span> : API Platform génère les opérations, la documentation OpenAPI et Swagger UI.</p>
          <ul class="cc-list">
            <li class="cc-row"><span class="cc-badge cc-badge--ok method">GET</span><div class="cc-row__main"><div class="cc-row__title cc-mono">/api/monsters</div><div class="cc-row__meta">Collection paginée</div></div></li>
            <li class="cc-row"><span class="cc-badge cc-badge--info method">POST</span><div class="cc-row__main"><div class="cc-row__title cc-mono">/api/monsters</div><div class="cc-row__meta">Création d'un monstre</div></div></li>
            <li class="cc-row"><span class="cc-badge cc-badge--ok method">GET</span><div class="cc-row__main"><div class="cc-row__title cc-mono">/api/monsters/{id}</div><div class="cc-row__meta">Lecture d'un élément</div></div></li>
            <li class="cc-row"><span class="cc-badge cc-badge--danger method">DELETE</span><div class="cc-row__main"><div class="cc-row__title cc-mono">/api/monsters/{id}</div><div class="cc-row__meta">Suppression</div></div></li>
          </ul>
          <div class="panel__actions">
            <a class="cc-btn cc-btn--sm cc-btn--gradient" href="/api">Ouvrir Swagger UI <span class="cc-btn__arrow">→</span></a>
            <a class="cc-btn cc-btn--sm" href="/api/monsters.jsonld">Monsters API · JSON-LD</a>
          </div>
        </div>

        <div class="cc-card cc-card--pad panel" id="panel-perf" role="tabpanel" data-panel="perf" hidden>
          <div class="panel__head">
            <div class="cc-card__label">Benchmark k6</div>
            <span class="cc-badge cc-badge--ok">0 erreur</span>
          </div>
          <div class="cc-card__title">Worker mode : p95 divisé par 2,4 face à PHP-FPM</div>
          <p class="cc-card__hint">Latence <span class="cc-kbd">http_req_duration</span> mesurée par k6 sur la page d'accueil, avec 10 puis 100 utilisateurs virtuels (VUs), en HTTP/2.</p>
          <table class="cc-table bench-table">
            <thead><tr><th>Mode</th><th>p95 · 10 VUs</th><th>p95 · 100 VUs</th><th>Moyenne · 100 VUs</th></tr></thead>
            <tbody>
              <tr><td>PHP-FPM</td><td>11,80 ms</td><td>15,97 ms</td><td>9,45 ms</td></tr>
              <tr><td>FrankenPHP classique</td><td>26,03 ms</td><td>22,44 ms</td><td>12,72 ms</td></tr>
              <tr class="is-best"><td>FrankenPHP worker</td><td>4,61 ms</td><td>6,66 ms</td><td>2,53 ms</td></tr>
            </tbody>
          </table>
          <p class="cc-card__hint cc-mt-2">Les rapports HTML complets sont dans la section Benchmarks ci-dessous.</p>
        </div>

        <div class="cc-card cc-card--pad panel" id="panel-deploy" role="tabpanel" data-panel="deploy" hidden>
          <div class="panel__head">
            <div class="cc-card__label">Déploiement FrankenPHP</div>
            <span class="cc-badge cc-badge--ok">git push</span>
          </div>
          <div class="cc-card__title">Aucun Dockerfile, un push, une URL en HTTPS</div>
          <p class="cc-card__hint">L'app est déclarée en type <strong>FrankenPHP</strong> : Clever Cloud fournit le binaire, installe les dépendances Composer à chaque push, démarre le worker sur le port <span class="cc-kbd">$PORT</span> et termine le TLS devant lui.</p>
          <ul class="cc-list">
            <li class="cc-row"><span class="cc-badge cc-badge--ok">✓</span><div class="cc-row__main"><div class="cc-row__title">Runtime FrankenPHP fourni</div><div class="cc-row__meta">Caddy et PHP dans un seul binaire, aucun Dockerfile à maintenir</div></div></li>
            <li class="cc-row"><span class="cc-badge cc-badge--ok">✓</span><div class="cc-row__main"><div class="cc-row__title">Mode worker activé</div><div class="cc-row__meta"><span class="cc-kbd">CC_FRANKENPHP_WORKER</span> : le kernel Symfony reste en mémoire entre les requêtes</div></div></li>
            <li class="cc-row"><span class="cc-badge cc-badge--ok">✓</span><div class="cc-row__main"><div class="cc-row__title">Hooks de build et de démarrage</div><div class="cc-row__meta">Les assets Swagger sont installés au build, les migrations jouées au démarrage</div></div></li>
            <li class="cc-row"><span class="cc-badge cc-badge--ok">✓</span><div class="cc-row__main"><div class="cc-row__title">Health check sur /health</div><div class="cc-row__meta">Bascule sans interruption à chaque déploiement</div></div></li>
          </ul>
          <pre class="cc-code"><span class="c"># Posé une seule fois sur l'application</span>
<span class="k">clever</span> env set CC_WEBROOT <span class="s">public</span>
<span class="k">clever</span> env set CC_FRANKENPHP_WORKER <span class="s">/public/index.php</span>

<span class="c"># Ensuite, à chaque changement</span>
<span class="k">git</span> push</pre>
          <div class="panel__actions">
            <a class="cc-btn cc-btn--sm cc-btn--gradient" href="https://console.clever-cloud.com" target="_blank" rel="noopener">Voir dans la Console <span class="cc-btn__arrow">→</span></a>
            <a class="cc-btn cc-btn--sm" href="https://www.clever.cloud/developers/doc/applications/frankenphp/" target="_blank" rel="noopener">Doc runtime FrankenPHP</a>
          </div>
        </div>

      </div>

      <div class="cc-platform cc-reveal" style="--i:8">
        <div class="cc-platform__head">
          <h3>Vu depuis Clever Cloud</h3>
          {% if cc.live %}
            <span class="cc-pill cc-pill--ok"><span class="cc-dot"></span>Production</span>
          {% else %}
            <span class="cc-pill cc-pill--muted"><span class="cc-dot cc-dot--muted"></span>Local · hors Clever Cloud</span>
          {% endif %}
        </div>
        <dl class="cc-kv">
          <div><dt>Application</dt><dd class="{{ cc.appName == '—' ? 'is-empty' }}">{{ cc.appName }}</dd></div>
          <div><dt>Instance</dt><dd class="{{ cc.instance == '—' ? 'is-empty' }}">{{ cc.instance }}</dd></div>
          <div><dt>Type d'instance</dt><dd class="{{ cc.instanceType == '—' ? 'is-empty' }}">{{ cc.instanceType }}</dd></div>
          <div><dt>Commit déployé</dt><dd class="{{ cc.commit == '—' ? 'is-empty' }}">{{ cc.commit }}</dd></div>
          <div><dt>App ID</dt><dd class="{{ cc.appId == '—' ? 'is-empty' }}">{{ cc.appId }}</dd></div>
          <div><dt>Déploiement</dt><dd class="{{ cc.deployment == '—' ? 'is-empty' }}">{{ cc.deployment }}</dd></div>
          <div><dt>PHP</dt><dd>{{ cc.php }}</dd></div>
          <div><dt>Worker</dt><dd class="{{ cc.worker ? '' : 'is-empty' }}">{{ cc.worker ? 'actif' : 'inactif (php -S)' }}</dd></div>
        </dl>
        <div class="cc-platform__foot">Variables injectées automatiquement par la plateforme : <a href="https://www.clever.cloud/developers/doc/reference/reference-environment-variables/" target="_blank" rel="noopener">référence</a>.</div>
      </div>
    </div>
  </div>
</section>

{# ── Benchmarks k6 ── #}
<section class="cc-section">
  <div class="cc-container">
    <div class="cc-section__head cc-reveal" style="--i:9">
      <h2 class="cc-section__title">Benchmarks k6</h2>
      <span class="cc-section__sub">p95 de <span class="cc-kbd">http_req_duration</span> · 100 VUs · 3 000 requêtes · 0 échec</span>
    </div>
    <div class="cc-grid cc-grid--3">
      <div class="cc-card cc-card--accent cc-reveal" style="--i:10">
        <div class="cc-card__label">PHP-FPM</div>
        <div class="cc-stat">15,97<span class="cc-stat__unit">ms · p95</span></div>
        <p class="cc-card__hint">Moyenne 9,45 ms. La référence classique : un processus FPM par requête.</p>
        <div class="bench-links">
          <a href="{{ path('benchmark_report', {name: 'summary-10-vus-fpm'}) }}">Rapport 10 VUs ↗</a>
          <a href="{{ path('benchmark_report', {name: 'summary-100-vus-fpm'}) }}">Rapport 100 VUs ↗</a>
        </div>
      </div>
      <div class="cc-card cc-card--accent cc-reveal" style="--i:11">
        <div class="cc-card__label">FrankenPHP classique</div>
        <div class="cc-stat">22,44<span class="cc-stat__unit">ms · p95</span></div>
        <p class="cc-card__hint">Moyenne 12,72 ms. Sans worker : Symfony est rebooté à chaque requête.</p>
        <div class="bench-links">
          <a href="{{ path('benchmark_report', {name: 'summary-10-vus-no-worker'}) }}">Rapport 10 VUs ↗</a>
          <a href="{{ path('benchmark_report', {name: 'summary-100-vus-no-worker'}) }}">Rapport 100 VUs ↗</a>
        </div>
      </div>
      <div class="cc-card cc-card--accent cc-card--best cc-reveal" style="--i:12">
        <div class="cc-card__label">FrankenPHP worker</div>
        <div class="cc-stat cc-grad-text">6,66<span class="cc-stat__unit">ms · p95</span></div>
        <p class="cc-card__hint">Moyenne 2,53 ms. Le kernel reste en mémoire : latence divisée par 2,4.</p>
        <div class="bench-links">
          <a href="{{ path('benchmark_report', {name: 'summary-10-vus-worker'}) }}">Rapport 10 VUs ↗</a>
          <a href="{{ path('benchmark_report', {name: 'summary-100-vus-worker'}) }}">Rapport 100 VUs ↗</a>
        </div>
      </div>
    </div>
  </div>
</section>

{# ── Ce que Clever Cloud fait ── #}
<section class="cc-section">
  <div class="cc-container">
    <div class="cc-section__head cc-reveal" style="--i:13">
      <h2 class="cc-section__title">Ce que Clever Cloud fait pour cette app</h2>
      <span class="cc-section__sub">Sans devops, sans serveur à gérer</span>
    </div>
    <div class="cc-grid cc-grid--3">
      <div class="cc-card cc-card--accent cc-reveal" style="--i:14"><div class="cc-card__label">Déploiement</div><div class="cc-card__title cc-mt-1">git push → composer install → run</div><p class="cc-card__hint">La plateforme installe les dépendances à chaque push, puis redémarre le worker sans interruption de service.</p></div>
      <div class="cc-card cc-card--accent cc-reveal" style="--i:15"><div class="cc-card__label">Runtime</div><div class="cc-card__title cc-mt-1">FrankenPHP natif, sans Dockerfile</div><p class="cc-card__hint">Le binaire est fourni par la plateforme ; le runtime PHP classique (Apache, PHP-FPM) reste disponible pour une app plus traditionnelle.</p></div>
      <div class="cc-card cc-card--accent cc-reveal" style="--i:16"><div class="cc-card__label">Confiance</div><div class="cc-card__title cc-mt-1">Hébergé en France</div><p class="cc-card__hint">ISO 27001, HDS, hors de portée des lois extraterritoriales.</p></div>
    </div>
  </div>
</section>

{% endblock %}

{% block javascripts %}
<script>
(function () {
  var tabs = document.querySelectorAll('.cc-tab[data-tab]');
  var panels = document.querySelectorAll('[data-panel]');
  function show(name) {
    tabs.forEach(function (tab) {
      var active = tab.dataset.tab === name;
      tab.classList.toggle('is-active', active);
      tab.setAttribute('aria-selected', active ? 'true' : 'false');
    });
    panels.forEach(function (panel) { panel.hidden = panel.dataset.panel !== name; });
  }
  tabs.forEach(function (tab) {
    tab.addEventListener('click', function () { show(tab.dataset.tab); });
  });
})();
</script>
{% endblock %}
