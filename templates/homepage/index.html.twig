{% extends 'base.html.twig' %}

{% block title %}FrankenPHP worker · Démo Clever Cloud{% endblock %}

{% set isWorker = w.mode == 'worker' %}
{% set na = 'injecté au déploiement' %}

{% block body %}
<div class="cc-container">

  {# ── Premier écran : le worker qui sert cette page ── #}
  <section class="fp-stage{{ isWorker ? ' is-worker' : ' is-classic' }}" aria-labelledby="stage-title">
    <div class="fp-stage__main cc-reveal" style="--i:0">
      <h1 id="stage-title" class="fp-title">
        Requête n°&nbsp;<span id="fp-count" class="fp-title__n">{{ w.request|number_format(0, ',', ' ') }}</span>.
      </h1>
      <p class="fp-sub">
        {% if isWorker %}
          <span class="fp-chip" style="--wc: var(--w0)">worker {{ w.worker }}</span>
          Même processus PHP depuis {{ w.uptime }} : Symfony est déjà en mémoire.
        {% else %}
          <span class="fp-chip is-cold">sans worker</span>
          Nouveau script PHP à chaque requête : Symfony redémarre de zéro.
        {% endif %}
      </p>
      <p class="fp-lead">Symfony 7.4 sur le runtime FrankenPHP de Clever Cloud. Une variable, <span class="cc-kbd">CC_FRANKENPHP_WORKER</span>, garde l'application chargée entre les requêtes, sans Dockerfile.</p>
      <div class="fp-cta">
        <button class="cc-btn cc-btn--gradient" type="button" id="fp-fire">Envoyer {{ demo.burstSize }} requêtes</button>
        <a class="cc-btn" href="#cert-title">Se certifier Clever Cloud ↓</a>
      </div>

      <figure class="fp-pulse" id="pulse" data-burst="{{ demo.burstSize }}" data-budget="{{ demo.latencyBudgetMs }}" data-page-worker="{{ w.worker }}" data-mode="{{ w.mode }}">
        <figcaption class="fp-pulse__head">
          <span>Rafale vers <code>/worker</code> · temps serveur par requête</span>
          <span class="fp-pulse__budget">budget {{ demo.latencyBudgetMs }} ms</span>
        </figcaption>
        <div class="fp-pulse__plot" role="img" id="fp-plot" aria-label="Aucune rafale envoyée pour l'instant">
          <i class="fp-pulse__line" id="fp-line" aria-hidden="true" hidden></i>
          <span class="fp-pulse__up" id="fp-up" hidden>budget {{ demo.latencyBudgetMs }} ms ↑</span>
          <p class="fp-pulse__empty" id="fp-empty">Aucune rafale envoyée.</p>
          <div class="fp-pulse__bars" id="fp-bars"></div>
        </div>
        <dl class="fp-pulse__stats" id="fp-stats" aria-live="polite" aria-atomic="true">
          <div><dt>Médiane</dt><dd data-k="median">—</dd></div>
          <div><dt>Sous {{ demo.latencyBudgetMs }} ms</dt><dd data-k="under">—</dd></div>
          <div><dt>Workers vus</dt><dd data-k="workers">—</dd></div>
          <div><dt>Redémarrages de Symfony</dt><dd data-k="boots">—</dd></div>
        </dl>
        <div class="fp-pulse__legend" id="fp-legend"></div>
      </figure>
    </div>

    <aside class="fp-proc cc-reveal" style="--i:1" aria-label="Processus PHP et variables d'environnement">
      <div class="fp-proc__bar"><i></i><i></i><i></i><span>{{ demo.platform.app ?? 'demo-php-frankenphp' }}</span><span class="fp-env{{ demo.isProduction ? ' is-production' }}">{{ demo.envName }}</span></div>
      <dl class="fp-proc__rows">
        <div><dt>Mode</dt><dd class="{{ isWorker ? 'is-ok' : 'is-cold' }}">{{ w.server }}</dd></div>
        <div><dt>Worker · PID</dt><dd>{{ w.worker }} · {{ w.pid }}</dd></div>
        <div><dt>En mémoire depuis</dt><dd id="fp-uptime">{{ w.uptime }}</dd></div>
        <div><dt>Requêtes servies</dt><dd><span id="fp-served">{{ w.request|number_format(0, ',', ' ') }}</span>{% if isWorker and w.loop_max > 0 %} / {{ w.loop_max }}{% endif %}</dd></div>
        <div><dt>FRANKENPHP_LOOP_MAX</dt><dd>{{ w.loop_max > 0 ? w.loop_max ~ ' requêtes' : 'jamais recyclé' }}</dd></div>
        <div><dt>Mémoire PHP</dt><dd>{{ w.memory_mb|number_format(1, ',', ' ') }} Mo</dd></div>
        <div><dt>Cette page</dt><dd>{{ w.server_ms|number_format(1, ',', ' ') }} ms serveur</dd></div>
      </dl>
      {% if isWorker and w.loop_max > 0 %}
      <div class="fp-recycle" style="--p: {{ (w.request / w.loop_max * 100)|round(1) }}%">
        <span></span>
        <small>Recyclé dans <b id="fp-recycle">{{ w.recycle_in }}</b> requêtes (FRANKENPHP_LOOP_MAX)</small>
      </div>
      {% elseif not isWorker %}
      <p class="fp-cold-note">Sans worker, rien n'est gardé d'une requête à l'autre. Sur Clever Cloud, <code>CC_FRANKENPHP_WORKER=/public/index.php</code> active le mode worker.</p>
      {% endif %}
      <ul class="fp-config" aria-label="Variables lues par l'application">
        <li><span>APP_ENV</span><b>{{ demo.envName }}</b></li>
        <li><span>LATENCY_BUDGET_MS</span><b>{{ demo.latencyBudgetMs }}</b></li>
        <li><span>BURST_SIZE</span><b>{{ demo.burstSize }}</b></li>
        <li><span>ANNOUNCEMENT</span>{% if demo.announcement is empty %}<b class="is-empty">non définie</b>{% else %}<b>définie</b>{% endif %}</li>
      </ul>
      <dl class="fp-proc__vars">
        <div><dt>Instance</dt><dd class="{{ demo.platform.instance is null ? 'is-empty' }}" title="{{ demo.platform.instance ?? na }}">{{ demo.platform.instance ?? na }}</dd></div>
        <div><dt>Type d'instance</dt><dd class="{{ demo.platform.type is null ? 'is-empty' }}" title="{{ demo.platform.type ?? na }}">{{ demo.platform.type ?? na }}</dd></div>
        <div><dt>Commit déployé</dt><dd class="{{ demo.platform.commit is null ? 'is-empty' }}" title="{{ demo.platform.commit ?? na }}">{{ demo.platform.commit ?? na }}</dd></div>
        <div><dt>Déploiement</dt><dd class="{{ demo.platform.deployment is null ? 'is-empty' }}" title="{{ demo.platform.deployment ?? na }}">{{ demo.platform.deployment ?? na }}</dd></div>
      </dl>
    </aside>
  </section>

  {% include 'partials/cert.html.twig' %}

  {# ── Benchmark k6 committé dans benchmark/ ── #}
  <section class="fp-bench" id="bench" aria-labelledby="bench-title">
    <div class="fp-bench__intro">
      <h2 id="bench-title" class="cc-section__title">Même page, trois façons de servir PHP.</h2>
      <p>Latence p95 mesurée par k6 sur la page d'accueil, 100 utilisateurs virtuels, 3 000 requêtes, 0 échec. Mesures faites en local (<code>https://localhost</code>, HTTP/2) et committées dans <code>benchmark/</code> : elles comparent les modes d'exécution entre eux.</p>
    </div>
    {% set rows = [
      {label: 'FrankenPHP classique', note: 'Symfony rebooté à chaque requête', p95: 22.44, avg: 12.72, med: 11.90, slug: 'no-worker'},
      {label: 'PHP-FPM', note: 'un processus FPM par requête', p95: 15.97, avg: 9.45, med: 9.28, slug: 'fpm'},
      {label: 'FrankenPHP worker', note: 'kernel gardé en mémoire', p95: 6.66, avg: 2.53, med: 1.56, slug: 'worker'},
    ] %}
    <ol class="fp-bench__rows">
      {% for r in rows %}
      <li class="{{ r.slug == 'worker' ? 'is-best' }}">
        <div class="fp-bench__label"><b>{{ r.label }}</b><span>{{ r.note }}</span></div>
        <div class="fp-bench__track" aria-hidden="true"><span style="--w: {{ (r.p95 / 22.44 * 100)|round(1) }}%"></span></div>
        <div class="fp-bench__val"><b>{{ r.p95|number_format(2, ',', ' ') }} ms</b><span>moyenne {{ r.avg|number_format(2, ',', ' ') }} · médiane {{ r.med|number_format(2, ',', ' ') }}</span></div>
        <div class="fp-bench__links"><a href="{{ path('benchmark_report', {name: 'summary-10-vus-' ~ r.slug}) }}">10 VUs ↗</a><a href="{{ path('benchmark_report', {name: 'summary-100-vus-' ~ r.slug}) }}">100 VUs ↗</a></div>
      </li>
      {% endfor %}
    </ol>
    <p class="fp-bench__take">En mode worker, le p95 est <b>2,4 fois</b> plus bas qu'avec PHP-FPM et <b>3,4 fois</b> plus bas que FrankenPHP sans worker.</p>
  </section>

  {# ── API Platform, en lecture seule ── #}
  <section class="fp-api" aria-labelledby="api-title">
    <div>
      <h2 id="api-title" class="cc-section__title">Une entité, une API en lecture seule.</h2>
      <p>API Platform génère les routes, la documentation OpenAPI et la Swagger UI à partir de l'entité <span class="cc-kbd">Monster</span>. Démo publique : seules les lectures sont exposées, toute écriture répond <span class="cc-kbd">405</span>.</p>
      <p class="fp-api__count"><b>{{ monsterCount }}</b> monstres lus dans SQLite, recréé à chaque démarrage par les migrations Doctrine.</p>
      <ul class="fp-api__list">
        {% for m in monsters %}<li><a href="/api/monsters/{{ m.id }}">{{ m.name }}</a></li>{% endfor %}
      </ul>
      <div class="fp-cta">
        <a class="cc-btn cc-btn--gradient" href="/api">Ouvrir Swagger UI</a>
        <a class="cc-btn" href="/api/monsters.jsonld">GET /api/monsters</a>
      </div>
    </div>
    <pre class="fp-code" aria-label="Extrait de src/Entity/Monster.php"><span class="c">// src/Entity/Monster.php</span>
<span class="k">#[ORM\Entity]</span>
<span class="k">#[ApiResource</span>(operations: [
    <span class="k">new</span> Get(), <span class="k">new</span> GetCollection(),
])<span class="k">]</span>
<span class="k">class</span> Monster
{
    <span class="k">#[ORM\Id, ORM\GeneratedValue, ORM\Column]</span>
    <span class="k">public</span> ?int $id = <span class="k">null</span>;

    <span class="k">#[ORM\Column</span>(type: Types::TEXT)<span class="k">]</span>
    <span class="k">public</span> ?string $name = <span class="k">null</span>;
}</pre>
  </section>

  {# ── Ce qui est posé sur l'application ── #}
  <section class="fp-deploy" aria-labelledby="deploy-title">
    <div>
      <h2 id="deploy-title" class="cc-section__title">Runtime FrankenPHP, sans Dockerfile.</h2>
      <p>Clever Cloud fournit le binaire FrankenPHP, lance <span class="cc-kbd">composer install --no-dev</span> à chaque push, joue les hooks puis démarre le worker. Le TLS et le domaine sont gérés devant l'app.</p>
      <ul class="fp-deploy__steps">
        <li><b>Build</b> : dépendances Composer, assets de la Swagger UI et cache Symfony préchauffé (<span class="cc-kbd">CC_POST_BUILD_HOOK</span>).</li>
        <li><b>Démarrage</b> : migrations Doctrine sur SQLite (<span class="cc-kbd">CC_PRE_RUN_HOOK</span>).</li>
        <li><b>Bascule</b> : <span class="cc-kbd">GET /health</span> doit répondre 200 avant de recevoir le trafic.</li>
      </ul>
    </div>
    <pre class="fp-code" aria-label="Variables posées sur l'application"><span class="c"># une seule fois</span>
<span class="k">clever</span> env set CC_WEBROOT <span class="s">public</span>
<span class="k">clever</span> env set CC_FRANKENPHP_WORKER <span class="s">/public/index.php</span>
<span class="k">clever</span> env set CC_HEALTH_CHECK_PATH <span class="s">/health</span>
<span class="k">clever</span> env set CC_CACHE_DEPENDENCIES <span class="s">true</span>

<span class="c"># ensuite, à chaque changement</span>
<span class="k">git</span> push clever main</pre>
  </section>

</div>
{% endblock %}

{% block javascripts %}
<script>
(function () {
  var fig = document.getElementById('pulse');
  if (!fig || !window.fetch) return;
  var btn = document.getElementById('fp-fire');
  var bars = document.getElementById('fp-bars');
  var plot = document.getElementById('fp-plot');
  var legend = document.getElementById('fp-legend');
  var stats = document.getElementById('fp-stats');
  var count = document.getElementById('fp-count');
  var served = document.getElementById('fp-served');
  var recycle = document.getElementById('fp-recycle');
  var line = document.getElementById('fp-line');
  var up = document.getElementById('fp-up');
  var empty = document.getElementById('fp-empty');
  var size = parseInt(fig.dataset.burst, 10) || 40;
  var budget = parseInt(fig.dataset.budget, 10) || 10;
  var pageWorker = fig.dataset.pageWorker;
  var label = btn.textContent;
  var fr = new Intl.NumberFormat('fr-FR', { maximumFractionDigits: 1 });
  var running = false;

  function set(k, v) { stats.querySelector('[data-k="' + k + '"]').textContent = v; }

  function render(results) {
    var colors = {}, order = [];
    if (fig.dataset.mode === 'worker') { colors[pageWorker] = 0; order.push(pageWorker); }
    results.forEach(function (r) { if (!(r.worker in colors)) { colors[r.worker] = order.length; order.push(r.worker); } });
    var sorted = results.map(function (r) { return r.server_ms; }).sort(function (a, b) { return a - b; });
    var p95 = sorted.length ? sorted[Math.min(sorted.length - 1, Math.ceil(sorted.length * 0.95) - 1)] : 0;
    var top = Math.max(budget / 4, p95 * 1.5);
    var lineAt = budget / top;
    line.hidden = lineAt > 1;
    line.style.bottom = (Math.min(lineAt, 1) * 100) + '%';
    up.hidden = lineAt <= 1;
    empty.hidden = true;
    bars.textContent = '';
    results.forEach(function (r, i) {
      var b = document.createElement('span');
      var h = Math.min(r.server_ms / top, 1);
      b.style.setProperty('--h', Math.max(h, 0.03).toFixed(3));
      b.style.setProperty('--n', i);
      b.style.setProperty('--wc', 'var(--w' + (colors[r.worker] % 6) + ')');
      if (r.server_ms > budget) b.className = 'is-over';
      b.title = 'Requête ' + r.request + ' du worker ' + r.worker + ' · ' + fr.format(r.server_ms) + ' ms';
      bars.appendChild(b);
    });
    var ms = results.map(function (r) { return r.server_ms; }).sort(function (a, b) { return a - b; });
    var median = ms.length ? ms[Math.floor((ms.length - 1) / 2)] : 0;
    var under = results.filter(function (r) { return r.server_ms <= budget; }).length;
    var seen = order.filter(function (id) { return results.some(function (r) { return r.worker === id; }); });
    var boots = results.filter(function (r) { return r.request === 1; }).length;
    set('median', fr.format(median) + ' ms');
    set('under', under + ' / ' + results.length);
    set('workers', seen.length);
    set('boots', boots === 0 ? '0 ✓' : boots);
    stats.querySelector('[data-k="boots"]').classList.toggle('is-ok', boots === 0);
    plot.setAttribute('aria-label', results.length + ' requêtes, médiane ' + fr.format(median) + ' ms, ' + under + ' sous le budget de ' + budget + ' ms, ' + seen.length + ' workers, ' + boots + ' redémarrages de Symfony');
    legend.textContent = '';
    if (seen.length <= 6) {
      seen.forEach(function (id) {
        var n = results.filter(function (r) { return r.worker === id; });
        var s = document.createElement('span');
        s.style.setProperty('--wc', 'var(--w' + (colors[id] % 6) + ')');
        s.textContent = id + ' · ' + n.length + ' req.';
        legend.appendChild(s);
      });
    } else {
      var s = document.createElement('em');
      s.textContent = seen.length + ' scripts PHP différents : sans worker, chaque requête repart de zéro.';
      legend.appendChild(s);
    }
    var mine = results.filter(function (r) { return r.worker === pageWorker && r.mode === 'worker'; });
    if (mine.length) {
      var last = mine[mine.length - 1];
      count.textContent = last.request.toLocaleString('fr-FR');
      served.textContent = last.request.toLocaleString('fr-FR');
      if (recycle && last.recycle_in !== null) recycle.textContent = last.recycle_in;
    }
  }

  function one() {
    return fetch('/worker', { cache: 'no-store', headers: { Accept: 'application/json' } })
      .then(function (r) { return r.ok ? r.json() : null; })
      .catch(function () { return null; });
  }

  function fire() {
    if (running) return;
    running = true;
    btn.disabled = true;
    btn.textContent = 'Rafale en cours…';
    var results = [], sent = 0;
    function batch() {
      if (sent >= size) {
        running = false;
        btn.disabled = false;
        btn.textContent = label;
        return;
      }
      var n = Math.min(4, size - sent), calls = [];
      for (var i = 0; i < n; i++) calls.push(one());
      sent += n;
      Promise.all(calls).then(function (list) {
        list.forEach(function (r) { if (r) results.push(r); });
        render(results);
        batch();
      });
    }
    batch();
  }

  btn.addEventListener('click', fire);
})();
</script>
{% endblock %}
